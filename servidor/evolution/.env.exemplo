# Copie pra .env e troque as duas senhas (use senhas longas e diferentes).
# Versão da Evolution API: na hora de instalar, confira a mais nova em github.com/EvolutionAPI/evolution-api/releases
EVOLUTION_IMAGE=atendai/evolution-api:v2.1.1

AUTHENTICATION_API_KEY=troque-por-uma-chave-longa
POSTGRES_PASSWORD=troque-esta-senha-do-banco

SERVER_URL=http://127.0.0.1:8080
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:troque-esta-senha-do-banco@postgres:5432/evolution
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution_v2
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
LANGUAGE=pt-BR

# Não guardar mensagens, conversas e contatos do WhatsApp no banco da Evolution
# (a agenda só precisa ENVIAR; guardar tudo faria o banco crescer sem parar)
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_DELETE_MESSAGE=true
